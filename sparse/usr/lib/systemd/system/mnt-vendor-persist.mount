[Unit]
Description=Droid mount for /mnt/vendor/persist
Before=local-fs.target systemd-modules-load.service

[Mount]
What=/dev/sda1
Where=/mnt/vendor/persist
Type=ext4
Options=noatime,nosuid,nodev,sync
# Options had SELinux context option:  

# Default is 90 which makes mount period too long in case of
# errors so drop it down a notch.
TimeoutSec=10

[Install]
WantedBy=local-fs.target

# From ./out/target/product/panther/vendor/etc/fstab.persist :
# /dev/sda1  /mnt/vendor/persist f2fs      noatime,nosuid,nodev,sync wait,check,formattable
